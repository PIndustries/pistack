# /etc/pistack/server.env, read by pistack-server.service.
# Lines are NAME=value, no quotes needed, no shell expansion.

# Flags with no variable of their own. An empty data directory needs one of:
#   --init         found a new cluster on this node
#   --join URL     adopt an existing control plane. URL is the https address
#                  of the leader's PISTACK_TLS_LISTEN.
# Once state.redb exists both are ignored, so they can stay here.
PISTACK_SERVER_ARGS=

# Join token for a server joining an existing cluster, and the fingerprint of
# the cloud's CA. `pi join-token create` prints both. Needed for the first
# start only.
#PISTACK_JOIN_TOKEN=
#PISTACK_JOIN_CA_SHA256=

# Join over plain http instead, with no fingerprint. The token and the whole
# store, secrets included, then cross the network in the clear.
#PISTACK_INSECURE_JOIN=true

# How servers call each other. `preferred` (the default) uses TLS to a server
# that has PISTACK_TLS_LISTEN and plain HTTP otherwise. `required` uses TLS
# only and refuses other servers on the plain listener; set it once every
# server has PISTACK_TLS_LISTEN.
#PISTACK_CLUSTER_TLS=required

# API listen address. This listener is plain HTTP.
PISTACK_LISTEN=0.0.0.0:8443

# HTTPS listener, on a specific address (not 0.0.0.0). Agents enrol and talk
# to the control plane here, and so do the other servers. The certificate
# comes from the cloud CA unless cert.pem, key.pem and ca.pem are in
# <data dir>/tls.
#PISTACK_TLS_LISTEN=10.0.0.10:8444

# URL agents are told to use for the HTTPS listener, when it is not
# https://<PISTACK_TLS_LISTEN>.
#PISTACK_AGENT_URL=https://cloud.example.net:8444

# URL clients use to reach this server. Defaults to https://<listen>.
#PISTACK_PUBLIC_URL=https://cloud.example.net:8444

# Where the store and keys live.
PISTACK_DATA_DIR=/var/lib/pistack

# Log filter, for example info,gate=debug.
PISTACK_LOG=info

# Name of this node in the cluster. Defaults to the host name.
#PISTACK_NODE_NAME=

# Password for the admin user, read once when the cluster is founded.
#PISTACK_ADMIN_PASSWORD=

# Network backend: hostnat, overlay, ovn or mock. The cluster remembers the
# choice, so a server without it adopts what the leader saved. With nothing
# set and nothing saved the server runs the mock fabric.
#PISTACK_FABRIC_BACKEND=overlay
