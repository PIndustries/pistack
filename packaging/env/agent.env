# /etc/pistack/agent.env, read by pistack-agent.service.
# Lines are NAME=value, no quotes needed, no shell expansion.

# URL of a control-plane node, normally its HTTPS listener. Required.
PISTACK_JOIN=

# Join token from the control plane, needed the first time this host enrols.
#PISTACK_JOIN_TOKEN=

# Where the agent keeps its certificate and node name.
PISTACK_DATA_DIR=/var/lib/pistack

# Log filter, for example info,anvil=debug.
PISTACK_LOG=info

# Name of this host in the cluster. Defaults to the host name.
#PISTACK_NODE_NAME=
