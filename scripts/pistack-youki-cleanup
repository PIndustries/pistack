#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 P. Industries LLC and PiStack contributors
# Sample sudoers line for the agent user. Name only this command:
#   ubuntu ALL=(root) NOPASSWD: /usr/local/sbin/pistack-youki-cleanup
"""Remove one path under the youki state directory.

    pistack-youki-cleanup delete --path <absolute-path>

The only command is `delete --path <path>`. The path must be absolute,
must not contain a `..` component, and must be strictly inside the youki
state directory. The state directory itself is refused. Symlinks are
unlinked and not followed, so a bundle entry that points outside the
state directory is not removed.

When this process is root, the state directory is
`/var/lib/pistack/youki` and environment overrides are ignored. sudo
resets the environment, so a custom `PISTACK_YOUKI_STATE` cannot widen
the directory. Leave the agent's state directory at that default when
`PISTACK_YOUKI_SUDO` is set.

A non-root process may set `PISTACK_YOUKI_CLEANUP_ROOT`, or
`PISTACK_YOUKI_STATE`, or `PISTACK_DATA_DIR` (the directory used is
`$PISTACK_DATA_DIR/youki`). Those are for tests. Leave them unset on a
host.

Install for the agent user `ubuntu`:

    install -m 0755 scripts/pistack-youki-cleanup /usr/local/sbin/pistack-youki-cleanup

    # /etc/sudoers.d/pistack-youki
    ubuntu ALL=(root) NOPASSWD: /usr/bin/youki, /usr/local/sbin/pistack-youki-cleanup

Replace `ubuntu` and `/usr/bin/youki` with the agent user and the youki
path on the host. Leave sudo's environment reset (the default). The
agent runs with
`PISTACK_YOUKI_CLEANUP=/usr/local/sbin/pistack-youki-cleanup`.

CI does not run this file as a package check. The checks here are
self_test(). From a checkout:

    python3 -c 'import runpy; runpy.run_path("scripts/pistack-youki-cleanup")["self_test"]()'
"""

from __future__ import annotations

import errno
import io
import os
import shutil
import stat
import subprocess
import sys
import tempfile
from typing import NoReturn, Optional

DEFAULT_ROOT = "/var/lib/pistack/youki"
TEST_ROOT_ENV = "PISTACK_YOUKI_CLEANUP_ROOT"
STATE_ENV = "PISTACK_YOUKI_STATE"
DATA_ENV = "PISTACK_DATA_DIR"


def die(msg: str) -> NoReturn:
    print(f"pistack-youki-cleanup: {msg}", file=sys.stderr)
    raise SystemExit(2)


def fail(msg: str) -> NoReturn:
    print(f"pistack-youki-cleanup: {msg}", file=sys.stderr)
    raise SystemExit(1)


def _bad_text(value: str) -> bool:
    return "\0" in value or any(ord(ch) < 32 or ord(ch) == 127 for ch in value)


def _has_dotdot(value: str) -> bool:
    return any(part == ".." for part in value.split("/"))


def _abs_dir(key: str, raw: str) -> str:
    if _bad_text(raw) or not os.path.isabs(raw) or _has_dotdot(raw):
        die(f"{key} must be an absolute path with no '..'")
    return os.path.normpath(raw)


def allowed_root() -> str:
    """Directory a removal path must live under.

    Root always uses /var/lib/pistack/youki. A non-root process may set
    PISTACK_YOUKI_CLEANUP_ROOT, PISTACK_YOUKI_STATE, or PISTACK_DATA_DIR
    for tests. Sudo resets the environment, and a root process ignores
    those variables even if one leaks through.
    """
    if os.geteuid() == 0:
        return DEFAULT_ROOT
    for key in (TEST_ROOT_ENV, STATE_ENV):
        raw = os.environ.get(key, "")
        if raw.strip():
            return _abs_dir(key, raw)
    data = os.environ.get(DATA_ENV, "")
    if data.strip():
        return os.path.normpath(os.path.join(_abs_dir(DATA_ENV, data), "youki"))
    return DEFAULT_ROOT


def refuse_path() -> NoReturn:
    die(
        "path must be absolute, contain no '..', and be inside "
        "/var/lib/pistack/youki"
    )


def check_removal_path(raw: str) -> str:
    if raw == "" or raw.endswith("/") or _bad_text(raw) or not os.path.isabs(raw):
        refuse_path()
    if _has_dotdot(raw):
        refuse_path()
    path = os.path.normpath(raw)
    if _has_dotdot(path) or not os.path.isabs(path):
        refuse_path()
    root = allowed_root()
    if path == root or not path.startswith(root + os.sep):
        refuse_path()
    return path


def _list_dir(path: str) -> list[str]:
    try:
        return os.listdir(path)
    except OSError as exc:
        if exc.errno not in (errno.EACCES, errno.EPERM):
            raise
    # The owner can chmod a mode 000 directory. Root can chmod a
    # root-owned one. 0700 is enough to list and unlink the children.
    try:
        os.chmod(path, 0o700)
    except OSError as exc:
        fail(f"cannot chmod {path}: {exc}")
    try:
        return os.listdir(path)
    except OSError as exc:
        fail(f"cannot list {path}: {exc}")


def remove_tree(path: str) -> None:
    """Remove `path` without following symlinks."""
    try:
        st = os.lstat(path)
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            return
        fail(f"cannot stat {path}: {exc}")
    if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
        try:
            os.unlink(path)
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                return
            fail(f"cannot remove {path}: {exc}")
        return
    try:
        names = _list_dir(path)
    except OSError as exc:
        fail(f"cannot list {path}: {exc}")
    for name in names:
        if name in ("", ".", "..") or "/" in name:
            fail(f"refusing entry {name!r} in {path}")
        remove_tree(os.path.join(path, name))
    try:
        os.rmdir(path)
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            return
        fail(f"cannot remove {path}: {exc}")


def main(argv: Optional[list[str]] = None) -> None:
    if argv is None:
        argv = sys.argv[1:]
    if len(argv) != 3 or argv[0] != "delete" or argv[1] != "--path" or argv[2] == "":
        die("usage: pistack-youki-cleanup delete --path <path>")
    path = check_removal_path(argv[2])
    remove_tree(path)


def _assert(cond: bool, what: str) -> None:
    if not cond:
        die(f"self-test: {what}")


def _refuses(fn, what: str) -> None:
    held = sys.stderr
    buf = io.StringIO()
    sys.stderr = buf
    try:
        fn()
    except SystemExit as exc:
        sys.stderr = held
        if exc.code == 2:
            return
        die(f"self-test: {what} exited {exc.code}: {buf.getvalue().strip()}")
    else:
        sys.stderr = held
        die(f"self-test: {what} was accepted")
    finally:
        sys.stderr = held


def _run(argv: list[str], env: dict[str, str]) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        [sys.executable, os.path.abspath(__file__), *argv],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
        check=False,
    )


def self_test() -> None:
    """Path refusal, symlink unlink, and removal of a mode 000 directory.

    Uses a temp directory. Does not touch /var/lib/pistack.
    """
    if os.geteuid() == 0:
        die("self-test: refuses to run as root")
    td = tempfile.mkdtemp(prefix="pistack-youki-cleanup-")
    saved = {
        key: os.environ.get(key) for key in (TEST_ROOT_ENV, STATE_ENV, DATA_ENV)
    }
    try:
        for key in saved:
            os.environ.pop(key, None)
        _run_self_test(td)
    finally:
        for key, value in saved.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
        _force_rmtree(td)
    print("pistack-youki-cleanup: self-test ok")


def _force_rmtree(path: str) -> None:
    for dirpath, dirnames, _filenames in os.walk(path, topdown=False, followlinks=False):
        for name in dirnames:
            try:
                os.chmod(os.path.join(dirpath, name), 0o700)
            except OSError:
                pass
        try:
            os.chmod(dirpath, 0o700)
        except OSError:
            pass
    shutil.rmtree(path, ignore_errors=True)


def _run_self_test(td: str) -> None:
    root = os.path.join(td, "youki")
    os.makedirs(root, mode=0o755)
    bundle = os.path.join(root, "bundle-1")
    os.makedirs(os.path.join(bundle, "rootfs"), mode=0o755)
    marker = os.path.join(bundle, "rootfs", "marker")
    with open(marker, "wb") as fh:
        fh.write(b"gone")
    sibling = os.path.join(root, "sibling")
    os.makedirs(sibling, mode=0o755)
    with open(os.path.join(sibling, "keep"), "wb") as fh:
        fh.write(b"keep")
    outside = os.path.join(td, "outside")
    os.makedirs(outside, mode=0o755)
    with open(os.path.join(outside, "keep"), "wb") as fh:
        fh.write(b"outside")

    os.environ[STATE_ENV] = root
    _assert(check_removal_path(bundle) == bundle, "bundle path")
    nested = os.path.join(bundle, "rootfs")
    _assert(check_removal_path(nested) == nested, "nested path")
    _assert(
        check_removal_path(os.path.join(root, "bundle-1", ".", "rootfs")) == nested,
        "dot component stays inside",
    )
    for raw, what in (
        ("bundle-1", "relative"),
        (root, "state directory itself"),
        (outside, "sibling of the state directory"),
        (bundle + "/", "trailing slash"),
        (os.path.join(root, "..", "outside"), "dot-dot"),
        (os.path.join(root, "bundle-1", "..", "sibling"), "dot-dot that stays inside"),
        (os.path.join(root, "bad\nname"), "newline"),
        ("/var/lib/pistack/youki/bundle-1", "default root while overridden"),
    ):
        _refuses(lambda raw=raw: check_removal_path(raw), what)
    _refuses(lambda: main(["delete"]), "missing args")
    _refuses(lambda: main(["delete", "--path"]), "missing path")
    _refuses(lambda: main(["delete", "--path", bundle, "extra"]), "extra arg")
    _refuses(lambda: main(["rm", "--path", bundle]), "other command")
    _refuses(lambda: main(["--self-test"]), "self-test flag")
    _refuses(lambda: main(["--help"]), "help flag")

    real_euid = os.geteuid
    os.geteuid = lambda: 0  # type: ignore[method-assign]
    try:
        os.environ[TEST_ROOT_ENV] = root
        _refuses(lambda: check_removal_path(bundle), "root ignores the test directory")
        _assert(allowed_root() == DEFAULT_ROOT, "root keeps the default state directory")
    finally:
        os.geteuid = real_euid  # type: ignore[method-assign]
        os.environ.pop(TEST_ROOT_ENV, None)

    base_env = os.environ.copy()
    base_env[STATE_ENV] = root
    base_env.pop(TEST_ROOT_ENV, None)
    base_env.pop(DATA_ENV, None)

    link = os.path.join(bundle, "escape")
    os.symlink(outside, link)
    proc = _run(["delete", "--path", link], base_env)
    _assert(proc.returncode == 0, f"symlink delete failed: {proc.stderr!r}")
    _assert(not os.path.lexists(link), "symlink remains")
    _assert(open(os.path.join(outside, "keep"), "rb").read() == b"outside", "symlink target removed")

    locked = os.path.join(bundle, "rootfs", "locked")
    os.makedirs(locked, mode=0o755)
    with open(os.path.join(locked, "file"), "wb") as fh:
        fh.write(b"root-owned")
    os.chmod(locked, 0)
    proc = _run(["delete", "--path", bundle], base_env)
    _assert(proc.returncode == 0, f"bundle delete failed: {proc.stderr!r}")
    _assert(not os.path.exists(bundle), "bundle remains")
    _assert(open(os.path.join(sibling, "keep"), "rb").read() == b"keep", "sibling removed")
    _assert(open(os.path.join(outside, "keep"), "rb").read() == b"outside", "outside removed")

    data_root = os.path.join(td, "data")
    data_bundle = os.path.join(data_root, "youki", "m-1")
    os.makedirs(data_bundle, mode=0o755)
    with open(os.path.join(data_bundle, "marker"), "wb") as fh:
        fh.write(b"data")
    env = os.environ.copy()
    env.pop(STATE_ENV, None)
    env.pop(TEST_ROOT_ENV, None)
    env[DATA_ENV] = data_root
    proc = _run(["delete", "--path", data_bundle], env)
    _assert(proc.returncode == 0, f"data-dir delete failed: {proc.stderr!r}")
    _assert(not os.path.exists(data_bundle), "data-dir bundle remains")
    _assert(os.path.isdir(os.path.join(data_root, "youki")), "state directory removed")

    proc = _run(["delete", "--path", os.path.join(root, "..", "outside")], base_env)
    _assert(proc.returncode != 0, "dot-dot path was accepted")
    _assert(open(os.path.join(outside, "keep"), "rb").read() == b"outside", "dot-dot deleted outside")
    proc = _run(["delete", "--path", root], base_env)
    _assert(proc.returncode != 0, "state directory was accepted")
    _assert(os.path.isdir(sibling), "state directory removal deleted a sibling")


if __name__ == "__main__":
    main()
