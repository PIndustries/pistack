[Unit]
Description=Restore PiStack floating IPs, security groups, and metadata doors
After=network-online.target libvirtd.service wg-quick@wg-fleet.service pistack.service pistack-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/pistack-fip restore

[Install]
WantedBy=multi-user.target
